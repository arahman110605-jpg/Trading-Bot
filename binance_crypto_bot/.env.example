# Binance CEX API Settings
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Web3 DEX Settings (BNB Smart Chain / Ethereum / Polygon)
WEB3_RPC_URL=https://bsc-dataseed.binance.org/
WEB3_PRIVATE_KEY=your_wallet_private_key_here
WEB3_CHAIN_ID=56

# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# Broker Type: "binance_spot", "binance_futures", or "web3_dex"
BROKER_TYPE=binance_spot

# Trading Config
CAPITAL=1000.0
LEVERAGE=5
DASHBOARD_PORT=5002
